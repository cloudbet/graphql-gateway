{
  "name": "graphql-gateway",
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "generate": "graphql-codegen --config graphql-codegen.yml",
    "dev": "NODE_ENV=development nodemon ./src/index.ts",
    "prod": "NODE_ENV=production nodemon ./src/index.ts",
    "build": "rimraf dist && tsc && copyfiles -u 1 src/**/*.graphql dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write . --log-level silent",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --max-warnings 0 --cache ."
    ]
  },
  "dependencies": {
    "@apollo/datasource-rest": "^6.4.1",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "graphql-scalars": "^1.26.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "^0.18.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@graphql-tools/mock": "^9.1.13",
    "@graphql-tools/schema": "^10.1.0",
    "@parcel/watcher": "^2.6.0",
    "@types/cors": "^2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
